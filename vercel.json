{
  "regions": [
    "fra1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/aktualna-dela",
      "destination": "/projekti",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/media/:file",
      "destination": "https://assets.cdn.filesafe.space/x59KaDfsCMuhMlks5lOI/media/:file"
    }
  ]
}
